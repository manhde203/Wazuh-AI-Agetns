# ======================================================================
# SOC SOAR Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ======================================================================

# ── Wazuh REST API (port 55000) ────────────────────────────────────────
WAZUH_HOST=192.168.1.40
WAZUH_PORT=55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=your_wazuh_password

# ── Wazuh Indexer / OpenSearch (port 9200) ────────────────────────────
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=your_indexer_password

# ── Telegram Bot ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Webhook (ai_agent_soc.py) ─────────────────────────────────────────
# Wazuh gửi kèm header X-Webhook-Token hoặc ?token=... ; để trống = không xác thực
WAZUH_WEBHOOK_TOKEN=change_me_random_string

# ── Threat Intelligence ───────────────────────────────────────────────
ABUSEIPDB_API_KEY=your_abuseipdb_api_key

# ── LLM (Ollama local or Groq fallback) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Recommended models (balance speed vs quality):
#   llama3.2:3b      — fast, low RAM, good for triage
#   qwen2.5:3b       — slightly better reasoning at same size
#   llama3.1:8b      — best quality if RAM allows
OLLAMA_MODEL=ollama/llama3.2
PIPELINE_TIMEOUT_SECONDS=600
CAMPAIGN_COOLDOWN_SECONDS=600

# ── Polling and Pipeline Settings ────────────────────────────────────
POLL_INTERVAL_SECONDS=30
MIN_ALERT_LEVEL=7

# ── Deduplication ─────────────────────────────────────────────────────
# Suppress identical alerts (same rule + IPs) within this window
DEDUP_WINDOW_MINUTES=10

# ── Alert Grouping ────────────────────────────────────────────────────
# Group alerts from the same attacker IP within this window (seconds)
# Alerts accumulate during the window, then flush as one campaign ticket
ALERT_GROUP_WINDOW_SECONDS=120

# Run the pipeline only when brute-force alerts exceed this number
BRUTE_FORCE_ALERT_THRESHOLD=20
# Cửa sổ trượt (giây) để đếm số alert brute-force
BRUTE_FORCE_WINDOW_SECONDS=60

# ── False Positive Guardrail ──────────────────────────────────────────
# Alerts where baseline FP confidence >= this threshold are auto-suppressed
# Range: 0–100. Lower = more aggressive suppression. Recommended: 75–85.
FP_SUPPRESSION_THRESHOLD=80

# ----------------------------------------------------------------------
# Biến mới (pipeline 4 AI Agent + giao diện terminal)
# ----------------------------------------------------------------------
# Tắt AI hoàn toàn (chỉ dùng quy tắc dự phòng): false
AI_ENABLED=true
# Thời gian tối đa cho MỖI agent (giây). Model lớn/CPU chậm → tăng lên.
AGENT_TIMEOUT_SECONDS=240
# Số alert lấy mỗi lần gọi Indexer (tự phân trang cho tới khi hết)
FETCH_LIMIT=200
# true: rule tổng hợp của Wazuh (đã gộp nhiều lần đăng nhập thất bại) kích hoạt ngay
BRUTE_FORCE_COMPOSITE_TRIGGER=true
# true: gửi Telegram cho TỪNG alert bị ẩn là false positive (có thể rất nhiều tin)
NOTIFY_SUPPRESSED=false
# Thư mục lưu file kết luận (.txt + .json). Mặc định: LabCDCS/reports
# REPORT_DIR=reports
# Tắt màu terminal: NO_COLOR=1
